<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Push to Detail Library"
    Height="640" Width="960"
    WindowStartupLocation="CenterScreen"
    ShowInTaskbar="False">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0" Margin="0,0,10,0">
        <TextBlock DockPanel.Dock="Top" Text="Drafting views in this project (Ctrl/Shift to multi-select)"
                   FontWeight="Bold" Margin="0,0,0,6" TextWrapping="Wrap"/>
        <ListBox x:Name="view_list" SelectionMode="Extended"
                 SelectionChanged="on_selection_changed"/>
      </DockPanel>

      <Border Grid.Column="1" BorderBrush="#FFB9B9B9" BorderThickness="1" Background="#FFF6F6F6">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock x:Name="preview_label" Grid.Row="0"
                     Text="Select a view to preview"
                     Margin="10" FontStyle="Italic" TextWrapping="Wrap"/>
          <Image x:Name="preview_image" Grid.Row="1" Margin="10" Stretch="Uniform"/>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="1" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Category:" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <ComboBox x:Name="category_box" Grid.Column="1" IsEditable="True"
                ToolTip="Pick an existing category or type a new one"/>
    </Grid>

    <Grid Grid.Row="2" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="password_label" Grid.Column="0" Text="Password:" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <PasswordBox x:Name="password_box" Grid.Column="1" Height="26"/>
    </Grid>

    <StackPanel Grid.Row="3" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button x:Name="push_button" Content="Push" Width="110" Height="30"
              Margin="0,0,8,0" Click="on_push"/>
      <Button x:Name="cancel_button" Content="Cancel" Width="110" Height="30"
              Click="on_cancel"/>
    </StackPanel>
  </Grid>
</Window>
