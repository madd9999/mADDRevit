<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Browse Detail Library"
    Height="640" Width="960"
    WindowStartupLocation="CenterScreen"
    ShowInTaskbar="False">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,8">
      <TextBlock DockPanel.Dock="Left" Text="Search:" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBox x:Name="search_box" TextChanged="on_search_changed"
               ToolTip="Filter by detail name or category"/>
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="340"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0" Margin="0,0,10,0">
        <TextBlock DockPanel.Dock="Top" Text="Details (Ctrl/Shift to multi-select)"
                   FontWeight="Bold" Margin="0,0,0,6" TextWrapping="Wrap"/>
        <ListBox x:Name="view_list" SelectionMode="Extended"
                 SelectionChanged="on_selection_changed"/>
      </DockPanel>

      <Border Grid.Column="1" BorderBrush="#FFB9B9B9" BorderThickness="1" Background="#FFF6F6F6">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock x:Name="preview_label" Grid.Row="0"
                     Text="Select a detail to preview"
                     Margin="10" FontStyle="Italic" TextWrapping="Wrap"/>
          <Image x:Name="preview_image" Grid.Row="1" Margin="10" Stretch="Uniform"/>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="2" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="password_label" Grid.Column="0" Text="Password (required to delete):"
                 VerticalAlignment="Center" Margin="0,0,8,0"/>
      <PasswordBox x:Name="password_box" Grid.Column="1" Height="26"/>
    </Grid>

    <StackPanel Grid.Row="3" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button x:Name="delete_button" Content="Delete" Width="110" Height="30"
              Margin="0,0,8,0" Click="on_delete"/>
      <Button x:Name="import_button" Content="Import" Width="110" Height="30"
              Margin="0,0,8,0" Click="on_import"/>
      <Button x:Name="cancel_button" Content="Cancel" Width="110" Height="30"
              Click="on_cancel"/>
    </StackPanel>
  </Grid>
</Window>
